generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// CORE & MULTI-TENANCY (Synced via Clerk Webhooks)
// -----------------------------------------------------------------------------

enum WorkspaceType {
  CREATIVE
  EDUCATION
  RESEARCH
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

model Business {
  id              String        @id // Matches Clerk Organization ID
  name            String
  defaultCurrency String        @default("USD")
  workspaceType   WorkspaceType @default(CREATIVE)

  // Invoice & Email Settings
  invoicePrefix                String  @default("INV")
  invoiceSeparator             String  @default("-")
  invoiceSequence              Int     @default(0)
  clientSequence               Int     @default(0)
  projectSequence              Int     @default(0)
  emailSubjectTemplate         String  @default("Invoice {{invoice_number}} from {{business_name}}")
  emailBodyTemplate            String  @default("Hi {{client_name}},\n\nHere is your invoice for {{total_amount}}.\n\nDue Date: {{due_date}}\n\nThank you!")
  paymentInstructions          String  @default("Please send payment via bank transfer to:\nBank: \nAccount Number: \nRouting Number: ")
  feedbackEmailSubjectTemplate String  @default("We'd love your feedback on {{project_name}}")
  feedbackEmailBodyTemplate    String  @default("Hi {{client_name}},\n\nYour project \"{{project_name}}\" has just been delivered by {{business_name}}.\nWe hope you love the final result!\n\nCould you take 2 minutes to let us know how we did? Your feedback helps us improve and serve you better.\n\nThanks for trusting us with your project.\n- The {{business_name}} Team")
  // Messaging Settings
  realtimeMessagesEnabled      Boolean @default(false)

  // Subscription Details
  //
  // subscriptionPlan is what is active right now; purchasedPlan is what was
  // paid for, until subscriptionPeriodEnd. They differ when a customer
  // voluntarily sits on a lower plan mid-period — the paid entitlement is still
  // theirs and can be restored. Recorded rather than inferred from
  // SubscriptionRequest history, which cannot distinguish a sale from an
  // administrative adjustment and silently picks the wrong row when a business
  // has bought more than one plan. Null means nothing is currently purchased.
  subscriptionPlan      SubscriptionPlan  @default(FREE)
  purchasedPlan         SubscriptionPlan?
  subscriptionPeriodEnd DateTime?
  customProjectLimit    Int?

  // Clerk user id of the organization creator. Identifies whose seat survives
  // when a plan drops below BUSINESS — checking org:admin instead would leave a
  // downgraded org with as many full-access seats as it has admins.
  // Nullable only for rows predating this column; see scripts/backfill-business-owner.ts.
  ownerUserId String?

  // Tracked per business as well as per user (User.hasUsedFreeTrial), because
  // the trial upgrades the *business*. Without this, cancelling back to FREE and
  // having any never-trialed member claim again renews Pro indefinitely.
  hasUsedFreeTrial Boolean @default(false)

  // Set when the Clerk organization is deleted, instead of destroying the rows
  // there and then. Any org:admin can delete an organization from Clerk's own
  // UI, which bypasses the account-deletion flow entirely — no export, no
  // reason, no confirmation. Keeping the data for a grace period turns a single
  // irreversible click into something recoverable. Safe to retain because with
  // no Clerk organization there is no session that can reach this workspace.
  pendingDeletionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionRequests SubscriptionRequest[]
  upgradeRequests      UpgradeRequest[]
  memberships          BusinessMembership[]
  clients              Client[]
  projects             Project[]
  workflowTemplates    WorkflowTemplate[]
  invoices             Invoice[]
  assets               Asset[]
  payments             Payment[]
  expenses             Expense[]
  creditNotes          CreditNote[]
  invoiceReminders     InvoiceReminder[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  feedbackRequests     FeedbackRequest[]
  feedbackResponses    FeedbackResponse[]
  testimonials         Testimonial[]
  reviewRequests       ReviewRequest[]
  analyticsSnapshots   AnalyticsSnapshot[]
  projectRequests      ProjectRequest[]
  Conversation         Conversation[]

  // Collaboration
  tasks     Task[]
  comments  Comment[]
  reactions Reaction[]

  /// Which reactions this organisation offers, in the order they are shown.
  /// Admin-editable, so a team can keep the set to what suits their work.
  reactionEmojis String[] @default(["👍", "✅", "🎉", "👀", "❤️", "🙏"])

  @@map("businesses")
}

model User {
  id                      String   @id // Matches Clerk User ID
  email                   String   @unique
  firstName               String?
  lastName                String?
  imageUrl                String?
  navPreferences          Json?
  quickActionPreferences  Json?
  notificationPreferences Json?
  hasUsedFreeTrial        Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships             BusinessMembership[]
  notifications           Notification[]
  assignedProjects        Project[]
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
  upgradeRequests         UpgradeRequest[]
  timeEntries             TimeEntry[]

  // Collaboration
  projectMemberships ProjectMember[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  createdTasks       Task[]          @relation("TaskCreator")
  completedTasks     Task[]          @relation("TaskCompleter")
  reactions          Reaction[]
  comments           Comment[]       @relation("CommentAuthor")
  mentions           Mention[]
  authoredNotes      Note[]          @relation("NoteAuthor")

  @@map("users")
}

model BusinessMembership {
  id                  String   @id @default(cuid())
  businessId          String
  userId              String
  role                String // e.g., "org:admin", "org:member"
  weeklyCapacityHours Int      @default(40)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_memberships")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS & PAYMENTS
// -----------------------------------------------------------------------------

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Replaces deleting an approved request. Revenue is derived from these rows,
  // so a hard delete silently rewrote historical totals.
  VOIDED
}

model SubscriptionRequest {
  id String @id @default(cuid())

  // Nullable, and detached rather than deleted when a workspace goes. This is
  // Cutline's own revenue ledger, not the customer's data: what a customer paid
  // us is our business record and our tax record, and it has to outlive their
  // account. Cascading it meant a solo owner deleting their account silently
  // erased their payments from our books.
  businessId String?

  planRequested SubscriptionPlan
  transactionId String                    @unique
  paymentMethod String
  status        SubscriptionRequestStatus @default(PENDING)

  // What was actually collected, in whole BDT, captured at approval.
  // Revenue used to be recomputed as count x current PLAN_PRICES, so changing a
  // price retroactively rewrote every historical total. Zero is a real and
  // expected value: an admin granting a plan is an entitlement change, not a
  // sale, and only becomes revenue if money was actually received.
  amountPaid Int?

  // When the money arrived, for revenue recognition. Distinct from updatedAt,
  // which moves whenever the row is touched — bucketing a monthly revenue chart
  // on a mutable column silently shifts past income between months.
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([status])
  @@map("subscription_requests")
}

model UpgradeRequest {
  id            String                    @id @default(cuid())
  businessId    String
  userId        String
  planRequested SubscriptionPlan
  message       String                    @db.Text
  status        SubscriptionRequestStatus @default(PENDING)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@map("upgrade_requests")
}

// -----------------------------------------------------------------------------
// DOMAIN MODELS (Strictly partitioned by businessId)
// -----------------------------------------------------------------------------

model Client {
  id                      String   @id @default(cuid())
  businessId              String
  displayId               String?
  displayName             String
  companyName             String?
  email                   String?
  phone                   String?
  industry                String?
  preferredChannel        String?
  preferredDeliveryMethod String?
  internalRating          Int?     @default(0) // 1-5 stars
  isArchived              Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projects         Project[]
  invoices         Invoice[]
  feedbackRequests FeedbackRequest[]
  testimonials     Testimonial[]
  reviewRequests   ReviewRequest[]
  Conversation     Conversation[]

  @@unique([businessId, displayId])
  @@unique([businessId, email]) // Prevent duplicate client emails within a business
  @@index([businessId]) // Critical for tenant data isolation performance
  @@map("clients")
}

model Project {
  id            String    @id @default(cuid())
  businessId    String
  displayId     String?
  clientId      String
  title         String
  type          String? // e.g., "YouTube Long-Form", "Corporate Ad"
  priority      String?
  deadline      DateTime?
  statusStageId String?
  orderIndex    Int       @default(0)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client           Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  statusStage      WorkflowStage?        @relation(fields: [statusStageId], references: [id])
  assigneeId       String?
  assignee         User?                 @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  stageHistory     ProjectStageHistory[]
  invoices         Invoice[]
  notes            Note[]
  links            ProjectLink[]
  timeEntries      TimeEntry[]
  assets           ProjectAsset[]
  expenses         Expense[]
  feedbackRequests FeedbackRequest[]
  testimonials     Testimonial[]
  reviewRequests   ReviewRequest[]

  // Collaboration
  members ProjectMember[]
  tasks   Task[]

  @@unique([businessId, displayId])
  @@index([businessId])
  @@index([clientId])
  @@index([statusStageId])
  @@map("projects")
}

// -----------------------------------------------------------------------------
// PRE-PRODUCTION: PROJECT REQUESTS
// -----------------------------------------------------------------------------

enum ProjectRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectRequest {
  id         String               @id @default(cuid())
  businessId String
  status     ProjectRequestStatus @default(PENDING)

  // Client info (stored as-is from the intake form)
  clientName       String
  clientEmail      String
  companyName      String?
  phone            String?
  industry         String?
  preferredChannel String?

  // Project info
  projectTitle   String
  projectType    String?
  scriptText     String? @db.Text
  scriptLink     String?
  rawFootageLink String?

  // Resolution
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@map("project_requests")
}

// -----------------------------------------------------------------------------
// WORKFLOW ENGINE
// -----------------------------------------------------------------------------

model WorkflowTemplate {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  projectType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stages   WorkflowStage[]

  @@index([businessId])
  @@map("workflow_templates")
}

model WorkflowStage {
  id             String  @id @default(cuid())
  templateId     String
  name           String
  orderIndex     Int
  estimatedHours Float?
  billingTrigger Boolean @default(false)
  icon           String?

  template WorkflowTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  projects Project[]
  history  ProjectStageHistory[]

  @@index([templateId])
  @@map("workflow_stages")
}

model ProjectStageHistory {
  id        String    @id @default(cuid())
  projectId String
  stageId   String
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([stageId])
  @@map("project_stage_history")
}

// -----------------------------------------------------------------------------
// FINANCIALS (V2)
// -----------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CREDIT_NOTE
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  CHECK
  OTHER
}

model Invoice {
  id         String  @id @default(cuid())
  businessId String
  clientId   String
  projectId  String?

  invoiceNumber String // e.g. CUT-2026-0042
  currency      String @default("USD")

  // Money in cents
  subtotalCents   Int @default(0)
  taxRateBps      Int @default(0) // Basis points e.g. 2000 = 20%
  taxAmountCents  Int @default(0)
  totalCents      Int @default(0)
  amountPaidCents Int @default(0)
  amountDueCents  Int @default(0)

  // For reporting
  fxRateSnapshot Decimal? @db.Decimal(10, 6)

  status InvoiceStatus @default(DRAFT)
  notes  String?       @db.Text
  pdfUrl String?

  issuedAt      DateTime?
  dueDate       DateTime?
  paidAt        DateTime?
  emailSentAt   DateTime?
  reminderCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  lineItems   InvoiceLineItem[]
  payments    Payment[]
  creditNotes CreditNote[]
  reminders   InvoiceReminder[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int    @default(1)
  amountCents Int // Price per unit in cents

  // To trace back to origin
  sourceType LineItemSourceType? @default(manual)
  sourceId   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id          String        @id @default(cuid())
  businessId  String
  invoiceId   String
  amountCents Int
  method      PaymentMethod
  reference   String? // Check number, Stripe TX ID

  reconciledAt       DateTime?
  reconciledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id         String  @id @default(cuid())
  businessId String
  projectId  String?

  amountCents    Int
  currency       String   @default("USD")
  fxRateSnapshot Decimal? @db.Decimal(10, 6)

  category     String // e.g. "Software", "Travel", "Contractor"
  description  String?
  dateIncurred DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([projectId])
  @@map("expenses")
}

model CreditNote {
  id                String @id @default(cuid())
  businessId        String
  originalInvoiceId String

  amountCents Int
  reason      String

  createdAt DateTime @default(now())

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  originalInvoice Invoice  @relation(fields: [originalInvoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([originalInvoiceId])
  @@map("credit_notes")
}

model InvoiceReminder {
  id         String @id @default(cuid())
  businessId String
  invoiceId  String

  tone    String // 'gentle', 'firm', 'final'
  channel String @default("email")

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceId])
  @@map("invoice_reminders")
}

model AuditLog {
  id           String  @id @default(cuid())
  businessId   String
  entityType   String // 'Invoice', 'Payment'
  entityId     String // Polymorphic reference — intentionally no FK (can reference Invoice, Payment, etc.)
  action       String // 'CREATE', 'UPDATE', 'VOID', 'PAYMENT_RECORDED'
  actorUserId  String? // Intentionally not FK-constrained: audit logs must survive user deletion
  metadataJson String? @db.Text

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([entityType, entityId])
  @@index([businessId, createdAt(sort: Desc)]) // Activity feed: newest-first per tenant
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// NOTES & TIME TRACKING
// -----------------------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  projectId String
  type      String // 'shot', 'client', 'idea', 'todo'
  content   String
  createdBy String? // Nullable: pre-existing notes have no author, and notes outlive their author
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation("NoteAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdBy])
  @@map("notes")
}

model TimeEntry {
  id              String    @id @default(cuid())
  projectId       String
  userId          String?
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  isBillable      Boolean   @default(true)
  source          String    @default("manual") // manual, stopwatch
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@map("time_entries")
}

// -----------------------------------------------------------------------------
// ASSET & LICENSE MANAGEMENT
// -----------------------------------------------------------------------------

enum AssetType {
  Music
  Font
  LUT
  Plugin
  StockFootage   @map("Stock Footage")
  SFX
  MotionGraphics @map("Motion Graphics")
}

enum LineItemSourceType {
  manual
}

model Asset {
  id          String    @id @default(cuid())
  businessId  String
  type        AssetType
  name        String
  vendor      String?
  licenseType String?
  expiresAt   DateTime?
  costCents   Int       @default(0) // stored in cents
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projects ProjectAsset[]

  @@unique([businessId, name, type]) // Prevent duplicate asset name+type within a business
  @@index([businessId])
  @@map("assets")
}

model ProjectAsset {
  id        String   @id @default(cuid())
  projectId String
  assetId   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([projectId, assetId])
  @@index([projectId])
  @@index([assetId])
  @@map("project_assets")
}

model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  url       String
  label     String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_links")
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  title      String
  message    String
  type       String   @default("system") // e.g., 'invoice', 'project', 'client', 'system'
  isRead     Boolean  @default(false)
  actionUrl  String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// CLIENT FEEDBACK & TESTIMONIALS
// -----------------------------------------------------------------------------

model FeedbackRequest {
  id               String    @id @default(cuid())
  businessId       String
  projectId        String
  clientId         String
  token            String    @unique
  status           String    @default("PENDING") // PENDING, COMPLETED, EXPIRED
  sentAt           DateTime  @default(now())
  responseDeadline DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  response FeedbackResponse?

  @@index([businessId])
  @@index([projectId])
  @@index([clientId])
  @@index([token])
  @@map("feedback_requests")
}

model FeedbackResponse {
  id               String   @id @default(cuid())
  businessId       String
  requestId        String   @unique
  overallScore     Int
  dimensionScores  Json?
  commentText      String?  @db.Text
  videoUrl         String?
  consentToPublish Boolean  @default(false)
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  request     FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  testimonial Testimonial?

  @@index([businessId])
  @@map("feedback_responses")
}

model Testimonial {
  id                 String    @id @default(cuid())
  businessId         String
  feedbackResponseId String    @unique
  projectId          String
  clientId           String
  displayText        String    @db.Text
  videoRef           String?
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feedbackResponse FeedbackResponse @relation(fields: [feedbackResponseId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([projectId])
  @@index([clientId])
  @@map("testimonials")
}

// -----------------------------------------------------------------------------
// POST-PRODUCTION REVIEWS
// -----------------------------------------------------------------------------

model ReviewRequest {
  id          String   @id @default(cuid())
  businessId  String
  projectId   String
  clientId    String
  token       String   @unique
  draftLink   String?
  status      String   @default("PENDING") // PENDING, REPLIED
  clientNotes String?  @db.Text
  clientLinks String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([projectId])
  @@index([clientId])
  @@index([token])
  @@map("review_requests")
}

// -----------------------------------------------------------------------------
// ANALYTICS & REPORTING
// -----------------------------------------------------------------------------

model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date // The date this snapshot represents

  revenueMTDCents       Int
  revenueLastMonthCents Int
  revenueDelta          Float
  outstandingCents      Int
  overdueCents          Int
  utilization           Float
  atRiskCount           Int
  avgFeedback           Float
  dso                   Float

  historicalTrendJson Json?

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId, date(sort: Desc)])
  @@map("analytics_snapshots")
}

// -----------------------------------------------------------------------------
// MESSAGING & BROADCASTS
// -----------------------------------------------------------------------------

enum ConversationType {
  DIRECT
  BROADCAST
  GROUP
  GUEST_LINK
}

model Conversation {
  id               String           @id @default(cuid())
  businessId       String
  type             ConversationType
  title            String?
  slowModeEnabled  Boolean          @default(false)
  slowModeCooldown Int              @default(10)
  createdBy        String

  // Guest Link functionality
  guestToken String? @unique
  guestName  String?
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  business     Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([businessId])
  @@index([guestToken])
  @@index([clientId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  isMuted        Boolean   @default(false)
  lastReadAt     DateTime?
  deletedAt      DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// A single emoji from one person on one message or comment.
///
/// Polymorphic on targetType/targetId, following the Comment precedent —
/// deliberately no foreign key, so one table serves both surfaces without a
/// join table each. Cleanup of a deleted target is by targetId.
model Reaction {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  emoji      String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One person may add several different emoji to the same thing, but only
  /// one of each — the toggle relies on this to be idempotent.
  @@unique([targetType, targetId, userId, emoji])
  @@index([targetType, targetId])
  @@index([businessId])
  @@map("reactions")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String?
  isGuest        Boolean   @default(false)
  content        String    @db.Text
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// -----------------------------------------------------------------------------
// TEAM COLLABORATION
// -----------------------------------------------------------------------------

enum ProjectMemberRole {
  OWNER // Full control, including managing the member list
  COLLABORATOR // Can edit the project and its tasks/notes
  WATCHER // Read-only; receives notifications
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

/// Replaces the single Project.assigneeId as the source of truth for who may
/// touch a project. assigneeId is retained as the "primary owner" pointer used
/// by dashboard/ProdP filters; this table is what authorization reads.
model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(COLLABORATOR)
  addedBy   String? // Actor who granted access; nullable so it survives their deletion
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_members")
}

/// Assignable unit of work below a Project — the thing teammates hand off.
model Task {
  id            String     @id @default(cuid())
  businessId    String // Denormalized from project for direct tenant-scoped queries
  projectId     String
  title         String
  description   String?    @db.Text
  status        TaskStatus @default(TODO)
  assigneeId    String?
  dueDate       DateTime?
  orderIndex    Int        @default(0)
  createdBy     String?
  completedAt   DateTime?
  /// Who marked it done — not necessarily the assignee, and the whole point of
  /// recording it separately. Cleared alongside completedAt when reopened.
  completedById String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator   User?    @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  completer User?    @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([projectId, orderIndex])
  @@index([assigneeId])
  @@map("tasks")
}

/// Threaded, in-context discussion. Polymorphic on entityType/entityId following
/// the AuditLog precedent — intentionally no FK, so one table serves projects,
/// tasks, invoices, etc. without a join table per target.
model Comment {
  id         String  @id @default(cuid())
  businessId String
  entityType String // 'Project', 'Task', 'Invoice'
  entityId   String
  authorId   String? // Nullable: comments outlive their author
  body       String  @db.Text
  parentId   String? // Set for replies; null for top-level comments

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime? // Soft delete keeps reply threads intact

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author   User?     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")
  mentions Mention[]

  @@index([businessId])
  @@index([entityType, entityId, createdAt])
  @@index([parentId])
  @@map("comments")
}

/// One row per @mentioned user on a comment. Drives notification fan-out and
/// the unread badge, which is why readAt lives here and not on Comment.
model Mention {
  id              String    @id @default(cuid())
  commentId       String
  mentionedUserId String
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId, readAt])
  @@map("mentions")
}

// -----------------------------------------------------------------------------
// GLOBAL ADMIN
// -----------------------------------------------------------------------------

model GlobalAdmin {
  id           String  @id @default(cuid())
  email        String  @unique
  // Null until the invite is accepted. A null hash must never be treated as
  // "set it to whatever was typed" — that made every pending account claimable
  // by anyone who knew the email address.
  passwordHash String?

  // Invite flow. Stored as a SHA-256 of the token rather than the token itself,
  // so read access to this table cannot be replayed into admin access.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  // Per-account brute-force lockout, threshold from
  // GlobalSettings.maxFailedLogins. Account-level rather than IP-level so it
  // survives IP rotation and works with no Redis configured.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Sessions issued before this instant are rejected. Moving it forward — on a
  // password change, or a deliberate "sign out everywhere" — revokes every
  // outstanding cookie without needing a session table.
  sessionsValidFrom DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_admins")
}

model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String // 'message', 'subscription', 'upgrade'
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  @@map("admin_notifications")
}

// -----------------------------------------------------------------------------
// GLOBAL SETTINGS
// -----------------------------------------------------------------------------

model GlobalSettings {
  id             String @id @default("default")
  paymentMethods Json   @default("[]")

  // 1. Maintenance & Access Control
  maintenanceMode Boolean @default(false)
  allowNewSignups Boolean @default(true)

  // 2. Trial & Subscription Defaults
  defaultTrialDays Int    @default(30)
  defaultPlanId    String @default("FREE")

  // 3. Communication & Support Overrides
  supportEmail String?
  replyToEmail String?
  termsUrl     String?
  privacyUrl   String?

  // 4. Platform Limitations & Quotas
  freeTierProjectLimit Int @default(3)
  proTierProjectLimit  Int @default(20)

  // Currency HQ reports its own money in. Distinct from Business.defaultCurrency,
  // which is what a tenant bills *their* clients in — this one is Cutline's.
  // Amounts were previously rendered with a hardcoded symbol in five places.
  currencyCode String @default("BDT")

  // Seats pushed to Clerk's maxAllowedMemberships for Business-plan orgs.
  // Must not exceed what the Clerk instance allows, or the write is rejected.
  // 0 means unlimited to Clerk. Plans below Business are always pinned to 1.
  businessTierSeatLimit Int @default(25)

  // 5. Security & Rate Limiting
  maxFailedLogins       Int @default(5)
  sessionTimeoutMinutes Int @default(15)

  updatedAt DateTime @updatedAt

  @@map("global_settings")
}

model SystemAlert {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, warning, error, success
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([targetId])
}

model SystemContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  source    String   @default("contact_form")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("system_contact_messages")
}

// -----------------------------------------------------------------------------
// PLATFORM FEEDBACK
// -----------------------------------------------------------------------------

model PlatformFeedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String // 'issue', 'idea', 'other'
  message   String   @db.Text
  url       String?
  status    String   @default("NEW") // NEW, REVIEWED, RESOLVED
  createdAt DateTime @default(now())

  @@map("platform_feedback")
}

// -----------------------------------------------------------------------------
// ACCOUNT DELETION
// -----------------------------------------------------------------------------

enum AccountDeletionStatus {
  // Requested; the data export still has to be sent by an admin.
  AWAITING_DATA
  // Export delivered and confirmed. Only now may the user complete deletion.
  DATA_DELIVERED
  COMPLETED
  CANCELLED
}

model AccountDeletionRequest {
  id String @id @default(cuid())

  // Both nullable so they can be cleared once the deletion completes. The row
  // survives as evidence that a request was made and honoured, holding only a
  // timestamp and the stated reason — keeping the email or the Clerk id would
  // contradict the promise shown to the user that no copies remain.
  userId    String?
  userEmail String?

  reason String                @db.Text
  status AccountDeletionStatus @default(AWAITING_DATA)

  requestedAt     DateTime  @default(now())
  dataDeliveredAt DateTime?
  // Which admin confirmed the export actually reached the user.
  deliveredBy     String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@map("account_deletion_requests")
}
